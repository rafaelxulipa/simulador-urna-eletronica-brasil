# PostgreSQL connection string (Neon, Supabase, or any Postgres-compatible
# provider). Required by the /api/* serverless functions (api/_db.ts) and by
# `pnpm sync:tse`. Never commit the real value — copy this file to
# .env.local and fill it in there (already gitignored).
DATABASE_URL=

# Frontend: which CandidateProvider to use. Defaults to "seed" (fictional
# example candidates, see docs/data-sources.md) when unset. Set to "api"
# once DATABASE_URL is populated via `pnpm sync:tse`, to use real data.
# VITE_CANDIDATE_SOURCE=api
